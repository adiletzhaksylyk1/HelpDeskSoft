# Generate separate random values; never use these placeholders in production.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
JWT_SECRET=CHANGE_ME_generate_at_least_48_random_characters
SECRET_ENCRYPTION_KEY=CHANGE_ME_64_hex_characters
CORS_ORIGIN=http://localhost:3000
TRUSTED_PROXIES=
STORAGE_DIR=./storage
ATTACHMENT_RETENTION_HOURS=24
CLEANUP_CHECK_INTERVAL_MS=3600000
IMAP_POLL_INTERVAL_MS=30000
MAX_ATTACHMENT_BYTES=10485760
MAX_MESSAGE_BYTES=26214400
LOG_LEVEL=info

# Compose requires three distinct passwords. Use URL-safe hex passwords.
POSTGRES_PASSWORD=CHANGE_ME_random_postgres_password
MIGRATION_DB_PASSWORD=CHANGE_ME_random_owner_password
APP_DB_PASSWORD=CHANGE_ME_random_runtime_password
# Native development: point at a disposable development database you created.
DATABASE_URL=postgresql://helpdesk_app:CHANGE_ME@127.0.0.1:5432/helpdesk
MIGRATION_DATABASE_URL=postgresql://helpdesk_owner:CHANGE_ME@127.0.0.1:5432/helpdesk

# Optional Compose TLS profile. Set CORS_ORIGIN=https://your-domain.
HELPDESK_DOMAIN=helpdesk.example.com
# Only the exact proxy IP should be trusted. Compose defaults to 172.30.50.10.
# HELPDESK_SUBNET=172.30.50.0/24
# HELPDESK_PROXY_IP=172.30.50.10

# Configure mailboxes through the admin UI. There is no runtime IMAP fallback.
# Legacy IMAP_* settings are imported once only, during migration 1.
# Optional SMTP_* defaults apply only to tickets without a linked mailbox.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_FROM=support@example.com
