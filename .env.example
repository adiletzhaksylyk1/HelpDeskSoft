# Application
APP_PORT=3000
APP_HOST=0.0.0.0
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_strong_secret
CORS_ORIGIN=https://helpdesk.youruniversity.edu
STORAGE_DIR=./storage
ATTACHMENT_RETENTION_HOURS=24
CLEANUP_CHECK_INTERVAL_MS=3600000

# Database
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@localhost:5433/helpdesk

# Inbound Email (IMAP)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASSWORD=change_me_imap_secret
IMAP_SECURE=true
IMAP_POLL_INTERVAL_MS=30000

# Outbound Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=change_me_smtp_secret
SMTP_SECURE=false
SMTP_FROM=Helpdesk Support <support@example.com>
