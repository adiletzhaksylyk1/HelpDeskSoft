{
  "name": "helpdesk-service",
  "version": "1.0.0",
  "description": "Production-oriented Helpdesk / Service Desk MVP",
  "main": "dist/backend/src/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('backend/src/public', 'dist/backend/src/public', { recursive: true, force: true })\"",
    "start": "node dist/backend/src/server.js",
    "dev": "tsx watch backend/src/server.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.frontend.json && node ops/check-frontend.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "admin:bootstrap": "tsx backend/src/modules/auth/bootstrap.ts",
    "test:browser": "npm run build && playwright test",
    "test:postgres": "vitest run tests/postgres.integration.test.ts",
    "test:postgres:local": "node ops/test-postgres.mjs",
    "format": "prettier --write backend/src tests ops/*.mjs *.json *.ts docker-compose.yml .github/workflows/*.yml"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
